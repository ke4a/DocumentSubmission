<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The API serves this app's files under /ui (see DocumentSubmission.Api/Program.cs).
         index.html therefore has no #[.{fingerprint}] placeholders: when another project publishes
         the app, the placeholder step moves index.html out of /ui. -->
    <StaticWebAssetBasePath>ui</StaticWebAssetBasePath>
    <!-- Hot reload adds a package script that the API would serve outside /ui, where the app cannot find it. -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
  </ItemGroup>

</Project>
